uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 uv_size;
uniform float2 offset;
uniform float dither_size;
uniform float contrast;
uniform float gamma;
uniform float color_steps;
uniform float dither_variant;
uniform float dither_diffusion_prepass;
uniform texture2d processed_image;
uniform texture2d real_blue_noise_mask;
sampler_state pointSampler {
    Filter = Point;
    AddressU = Clamp;
    AddressV = Clamp;
};

sampler_state textureSampler{
    Filter = Linear;
    AddressU = Clamp;
    AddressV = Clamp;
    MinLOD = 0;
    MaxLOD = 0;
};

struct VertData
{
	float4 pos : POSITION;
	float2 uv : TEXCOORD0;
};

// Hilbert R1 Noise from https://www.shadertoy.com/view/cl2GRm

#define HILBERT_LEVEL 0x7        // bigger = slower but less tiling
#define HILBERT_WIDTH 0x80       // 0x1 << HILBERT_LEVEL

// based on [roberts]
float quasirand_r1(int n)
{
	const float INV_PHI = 0.61803398874989484820;
	return frac(0.5 + INV_PHI * float(n));
}

// original from https://www.shadertoy.com/view/XtGBDW
int HilbertIndex(int2 Position)
{
	int Index = 0x0;
	for (int CurLevel = HILBERT_WIDTH / 2; CurLevel > 0; CurLevel /= 2)
	{
		int2 pcl = int2(Position.x & CurLevel, Position.y & CurLevel);
		int2 Region = int2(pcl.x > 0 ? 1 : 0, pcl.y > 0 ? 1 : 0);
      // //int2 Region = int2(greaterThan((Position & int2(CurLevel, CurLevel)), int2(0U, 0U)));
		Index += CurLevel * CurLevel * ((3 * Region.x) ^ Region.y);
		if (Region.y == 0)
		{
			if (Region.x == 1)
				Position = int2(HILBERT_WIDTH - 1, HILBERT_WIDTH - 1) - Position;
			Position.xy = Position.yx;
		}
	}
	return Index;
}

float2 mod(float2 x, float2 y)
{
	return x - y * floor(x / y);
}

// original from https://www.shadertoy.com/view/3tB3z3
float HilbertR1Noise(float2 p)
{
	return quasirand_r1(HilbertIndex(int2(p)) % 131072);
}

float3 HilbertR1Noise_rgb(float2 p)
{
	float h1 = HilbertR1Noise(p);
	float h2 = HilbertR1Noise(p + float2(1234., 0.));
	float h3 = HilbertR1Noise(p + float2(0., 1234.));
	return float3(h1, h2, h3);
}

// [roberts] recommends remapping their proposed R2Noise dither mask
// through this formula to eliminate the discontinuities from fract().
// Looks like it improves dithering for other noises too.
float3 TriWave(float3 z)
{ // z in [0..1]
	return lerp(2.0 * z, 2.0 - 2.0 * z, step(0.5, z));
}

float3 BlueNoise(float2 p)
{
	float3 noise = HilbertR1Noise_rgb(p);
	return TriWave(noise);
}

float RGBToLum(float3 color)
{
	return 0.299 * color.r + 0.587 * color.g + 0.114 * color.b;
}

// UV: proportion across source texture, 0 to 1
// tx: source texels, 0 to uv_size-1
// px: output-scaled pixels

float2 txFromUv(float2 uv)
{
	return floor(uv * uv_size.xy);
}

float2 uvFromTx(float2 tx)
{
	return (tx + 0.5) / uv_size.xy;
}

float2 pxFromTx(float2 tx)
{
	return floor(tx / dither_size);
}

float2 txFromPx(float2 px)
{
	return floor((px + 0.5f) * dither_size);
}

float2 uvFromPx(float2 px)
{
	return uvFromTx(txFromPx(px));
}

float2 pxFromUv(float2 uv)
{
	return pxFromTx(txFromUv(uv));
}

#ifdef USE_BAYER2
float get_bayer(float2 px)
{
#ifdef OPENGL
	const int bayer2[4] = int[4](0, 2, 3, 1);
#else
	const int bayer2[4] = { 0, 2, 3, 1 };
#endif
	float2 sample_coord = mod(px, float2(2.0, 2.0));
	return float(bayer2[int(sample_coord.y) * 2 + int(sample_coord.x)]) / 4.0;
}
#endif

#ifdef USE_BAYER4
float get_bayer(float2 px)
{
#ifdef OPENGL
	const int bayer4[16] = int[16](
		0, 8, 2, 10,
		12, 4, 14, 6,
		3, 11, 1, 9,
		15, 7, 13, 5
	);
#else
	int bayer4[16] =
	{
		0, 8, 2, 10,
		12, 4, 14, 6,
		3, 11, 1, 9,
		15, 7, 13, 5
	};
#endif
	float2 sample_coord = mod(px, float2(4.0, 4.0));
	return float(bayer4[int(sample_coord.y) * 4 + int(sample_coord.x)]) / 16.0;
}
#endif

#ifdef USE_BAYER8
float get_bayer(float2 px)
{
#ifdef OPENGL
	const int bayer8[64] = int[64](
		0, 32, 8, 40, 2, 34, 10, 42,
		48, 16, 56, 24, 50, 18, 58, 26,
		12, 44, 4, 36, 14, 46, 6, 38,
		60, 28, 52, 20, 62, 30, 54, 22,
		 3, 35, 11, 43, 1, 33, 9, 41,
		51, 19, 59, 27, 49, 17, 57, 25,
		15, 47, 7, 39, 13, 45, 5, 37,
		63, 31, 55, 23, 61, 29, 53, 21
	);
#else
	int bayer8[64] =
	{
		0, 32, 8, 40, 2, 34, 10, 42,
		48, 16, 56, 24, 50, 18, 58, 26,
		12, 44, 4, 36, 14, 46, 6, 38,
		60, 28, 52, 20, 62, 30, 54, 22,
		 3, 35, 11, 43, 1, 33, 9, 41,
		51, 19, 59, 27, 49, 17, 57, 25,
		15, 47, 7, 39, 13, 45, 5, 37,
		63, 31, 55, 23, 61, 29, 53, 21
	};
#endif
	float2 sample_coord = mod(px, float2(8.0, 8.0));
	return (float(bayer8[int(sample_coord.y) * 8 + int(sample_coord.x)]) / 64.0);
}
#endif

float4 sampleSource(float2 uv)
{
#ifdef ROUND_UV_TO_PIXEL
	float4 color = image.Sample(textureSampler,
	    dither_diffusion_prepass > 0.5 ? uv : uvFromPx(pxFromUv(uv)));
#else
	float4 color = image.Sample(textureSampler, uv);
#endif

	// Calcuate color correction factors
	float gammaCorrection = 1.0 / gamma;
	float contrastFactor = (259.0 * (contrast + 255.0)) / (255.0 * (259.0 - contrast));

	// Correct color
	color.rgb = pow(color.rgb, float3(gammaCorrection, gammaCorrection, gammaCorrection));
	color.rgb = saturate(contrastFactor * (color.rgb - 0.5) + 0.5);

	return color;
}

float4 sampleSourceMono(float2 uv)
{
	float4 color = sampleSource(uv);
	float lum = RGBToLum(color.rgb);
	return float4(lum, lum, lum, color.a);
}

float3 quantise(float3 color, float dither)
{
	return floor(color.rgb * color_steps + dither) / color_steps;
}

// Ulichney void-and-cluster: pregenerated, tileable 64x64 rank mask.
// Sample at exact pixel centers with point filtering, no interpolation.
float4 ApplyTrueBlueNoise(float4 color, float2 uv)
{
	float2 pixel = pxFromUv(uv);
	float2 cell = mod(pixel - offset, float2(64.0, 64.0));
	// R8 samples are normalized by 255. Remap their 256 ranks to bin centers
	// strictly inside [0, 1), so a mask value of 255 cannot brighten black.
	float rank = real_blue_noise_mask.Sample(pointSampler, (cell + 0.5) / 64.0).r * 255.0;
	float threshold = (rank + 0.5) / 256.0;
	color.rgb = quantise(color.rgb, threshold);
	return color;
}

float4 ApplyPosterize(float4 color)
{
	// Nearest palette level. No Bayer/noise/error diffusion whatsoever.
	color.rgb = floor(color.rgb * color_steps + 0.5) / color_steps;
	return color;
}

float4 ApplyBlueNoise(float4 color, float2 uv)
{
	float2 px = pxFromUv(uv);
	float noise = RGBToLum(BlueNoise(px - offset));
	color.rgb = quantise(color.rgb, noise);
	return color;
}

// The three 2x2 stylistic matrices are the EXACT distributions used in
// noita-chat/utils/colorScience.ts, not standard 2x2 Bayer permutations.
// Matrix rows: H [[3,3],[1,0]], V [[1,3],[0,3]], D [[3,0],[0,2]].
float directional_2x2_mask(float2 px)
{
	float2 cell = mod(px, float2(2.0, 2.0));
	bool right = cell.x >= 1.0;
	bool bottom = cell.y >= 1.0;
	float rank = 0.0;
	if (dither_variant < 3.5) {
		rank = bottom ? (right ? 0.0 : 1.0) : 3.0;
	} else if (dither_variant < 4.5) {
		rank = right ? 3.0 : (bottom ? 0.0 : 1.0);
	} else {
		rank = bottom ? (right ? 2.0 : 0.0) : (right ? 0.0 : 3.0);
	}
	// Noita uses (rank + .5)/4 as threshold; the OBS quantizer applies
	// floor(color*color_steps + threshold). Keep the same threshold distribution.
	return (rank + 0.5) / 4.0;
}

float4 ApplyDitherNoise(float4 color, float2 uv)
{
	float2 px = pxFromUv(uv);
	float noise = (dither_variant >= 3.0 && dither_variant <= 5.0) ? directional_2x2_mask(px) : get_bayer(px);
	color.rgb = quantise(color.rgb, noise);
	return color;
}

VertData mainTransform(VertData v_in)
{
	v_in.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	return v_in;
}

float4 mainImageColorBN(VertData v_in) : TARGET
{
	float4 color = sampleSource(v_in.uv);

	return ApplyBlueNoise(color, v_in.uv);
}

float4 mainImageMonoBN(VertData v_in) : TARGET
{
	float4 color = sampleSourceMono(v_in.uv);

	return ApplyBlueNoise(color, v_in.uv);
}

float4 mainImageColorOrdered(VertData v_in) : TARGET
{
	float4 color = sampleSource(v_in.uv);

	return ApplyDitherNoise(color, v_in.uv);
}

float4 mainImageMonoOrdered(VertData v_in) : TARGET
{
	float4 color = sampleSourceMono(v_in.uv);

	return ApplyDitherNoise(color, v_in.uv);
}

float4 mainImageColorBlueNoiseMask(VertData v_in) : TARGET
{
	return ApplyTrueBlueNoise(sampleSource(v_in.uv), v_in.uv);
}
float4 mainImageMonoBlueNoiseMask(VertData v_in) : TARGET
{
	return ApplyTrueBlueNoise(sampleSourceMono(v_in.uv), v_in.uv);
}
float4 mainImageColorPosterize(VertData v_in) : TARGET
{
	return ApplyPosterize(sampleSource(v_in.uv));
}
float4 mainImageMonoPosterize(VertData v_in) : TARGET
{
	return ApplyPosterize(sampleSourceMono(v_in.uv));
}

technique DrawColorBlueNoiseMask
{
	pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageColorBlueNoiseMask(v_in); }
}
technique DrawMonoBlueNoiseMask
{
	pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageMonoBlueNoiseMask(v_in); }
}
technique DrawColorPosterize
{
	pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageColorPosterize(v_in); }
}
technique DrawMonoPosterize
{
	pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageMonoPosterize(v_in); }
}

technique DrawColorBN
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader = mainImageColorBN(v_in);
	}
}

technique DrawMonoBN
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader = mainImageMonoBN(v_in);
	}
}

technique DrawColorOrdered
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader = mainImageColorOrdered(v_in);
	}
}

technique DrawMonoOrdered
{
	pass
	{
		vertex_shader = mainTransform(v_in);
		pixel_shader = mainImageMonoOrdered(v_in);
	}
}


// CPU error-diffusion prepass applies color correction without noise.
float4 mainImageDitherSourceColor(VertData v_in) : TARGET { return sampleSource(v_in.uv); }
float4 mainImageDitherSourceMono(VertData v_in) : TARGET { return sampleSourceMono(v_in.uv); }
float4 mainImageDitherProcessed(VertData v_in) : TARGET {
    return processed_image.Sample(pointSampler, v_in.uv);
}
technique DrawColorSource {
    pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageDitherSourceColor(v_in); }
}
technique DrawMonoSource {
    pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageDitherSourceMono(v_in); }
}
technique DrawDiffused {
    pass { vertex_shader = mainTransform(v_in); pixel_shader = mainImageDitherProcessed(v_in); }
}
