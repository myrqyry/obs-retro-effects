# Resolve the codec libraries as a single SDK, not unrelated system libraries.
# On Windows/macOS the existing OBS dependency bootstrap contributes prefixes.
# An explicit root is authoritative; never fall back to another installation.
set(RETRO_FFMPEG_ROOT "" CACHE PATH "FFmpeg SDK prefix (include/ and lib/)")
add_library(retro_ffmpeg INTERFACE)
if(NOT RETRO_FFMPEG_ROOT AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(VIDEO_FFMPEG REQUIRED IMPORTED_TARGET libavcodec libavutil libswscale)
  target_link_libraries(retro_ffmpeg INTERFACE PkgConfig::VIDEO_FFMPEG)
else()
  if(RETRO_FFMPEG_ROOT)
    set(_retro_prefixes "${RETRO_FFMPEG_ROOT}")
  else()
    set(_retro_prefixes "${CMAKE_PREFIX_PATH}")
  endif()
  set(_retro_found FALSE)
  foreach(_prefix IN LISTS _retro_prefixes)
    unset(_retro_include)
    find_path(_retro_include NAMES libavcodec/avcodec.h PATHS "${_prefix}"
      PATH_SUFFIXES include "include/${CMAKE_LIBRARY_ARCHITECTURE}" NO_DEFAULT_PATH NO_CACHE)
    if(NOT _retro_include OR
       NOT EXISTS "${_retro_include}/libavutil/avutil.h" OR
       NOT EXISTS "${_retro_include}/libswscale/swscale.h")
      continue()
    endif()
    set(_retro_libraries "")
    foreach(_component IN ITEMS avcodec avutil swscale)
      unset(_retro_lib)
      find_library(_retro_lib NAMES "${_component}" PATHS "${_prefix}"
        PATH_SUFFIXES lib lib64 "lib/${CMAKE_LIBRARY_ARCHITECTURE}" NO_DEFAULT_PATH NO_CACHE)
      if(NOT _retro_lib)
        break()
      endif()
      list(APPEND _retro_libraries "${_retro_lib}")
    endforeach()
    list(LENGTH _retro_libraries _retro_count)
    if(_retro_count EQUAL 3)
      set(_retro_found TRUE)
      target_include_directories(retro_ffmpeg SYSTEM INTERFACE "${_retro_include}")
      target_link_libraries(retro_ffmpeg INTERFACE ${_retro_libraries})
      message(STATUS "Retro codec FFmpeg SDK: ${_prefix}")
      break()
    endif()
  endforeach()
  if(NOT _retro_found)
    message(FATAL_ERROR "No complete FFmpeg SDK in the selected prefix(es). Set RETRO_FFMPEG_ROOT to the OBS-compatible SDK containing avcodec, avutil and swscale headers and libraries.")
  endif()
endif()
